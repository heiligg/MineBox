[Unit]
Description=MineBox API
Documentation=http://127.0.0.1:8080/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minebox
Group=minebox
WorkingDirectory=/opt/minebox
ExecStart=/usr/bin/uvicorn api.server:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/minecraft /var/lib/minebox /var/log/minebox

[Install]
WantedBy=multi-user.target
