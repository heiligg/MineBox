[Unit]
Description=MineBox Appliance Interface (curses recovery on tty1)
Documentation=file:///opt/minebox/docs/v1/Systemd_Services.md
After=minebox-firstboot.service systemd-user-sessions.service minebox-api.service
Requires=minebox-firstboot.service
Wants=minebox-api.service
Conflicts=getty@tty1.service
# Recovery console must stay available; bound restart rate to avoid loops.
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=minebox
Group=minebox
SupplementaryGroups=video input render gpio
WorkingDirectory=/opt/minebox
Environment=TERM=linux
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/minebox/main.py
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=15
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
