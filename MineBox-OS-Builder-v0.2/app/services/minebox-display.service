[Unit]
Description=MineBox graphical local display (800x480 kiosk)
Documentation=file:/opt/minebox/docs/v1/Display_Kiosk_Setup.md
After=minebox-api.service
Wants=minebox-api.service
# Curses recovery UI owns tty1/HDMI framebuffer; stop it while the kiosk runs.
Conflicts=minebox-ui.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=minebox
Group=minebox
SupplementaryGroups=video input render gpio
WorkingDirectory=/opt/minebox
Environment=PYTHONUNBUFFERED=1
Environment=MINEBOX_DISPLAY_URL=http://127.0.0.1:8080/display
Environment=MINEBOX_KIOSK_PROFILE=/var/lib/minebox/chromium-kiosk
Environment=DISPLAY=:0
Environment=XAUTHORITY=/var/lib/minebox/.Xauthority
ExecStartPre=/usr/bin/install -d -o minebox -g minebox -m 700 /var/lib/minebox/chromium-kiosk
ExecStartPre=/usr/bin/chmod 0755 /opt/minebox/scripts/minebox_display_session.sh /opt/minebox/scripts/minebox_kiosk_launch.sh
# Requires /etc/X11/Xwrapper.config allowed_users=anybody (minebox-ensure-panel).
ExecStart=/usr/bin/xinit /opt/minebox/scripts/minebox_display_session.sh -- :0 vt7 -nolisten tcp
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
