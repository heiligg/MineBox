[Unit]
Description=MineBox API
Documentation=http://127.0.0.1:8080/docs
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minebox
Group=minebox
WorkingDirectory=/opt/minebox
Environment=PYTHONPATH=/opt/minebox
Environment=PYTHONUNBUFFERED=1
# Ensure server files stay writable by the dashboard (runs as root once).
ExecStartPre=+/usr/bin/python3 /opt/minebox/scripts/minebox_fix_minecraft_perms.py
ExecStart=/usr/bin/python3 /opt/minebox/scripts/minebox_api_run.py
Restart=on-failure
RestartSec=3

NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/minebox /opt/minecraft /var/lib/minebox /var/log/minebox /home/minebox

[Install]
WantedBy=multi-user.target
