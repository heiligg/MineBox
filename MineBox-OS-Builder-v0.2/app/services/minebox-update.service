[Unit]
Description=MineBox GitHub software update
Documentation=http://127.0.0.1:8080
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/minebox/scripts/minebox_update_apply.py
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
