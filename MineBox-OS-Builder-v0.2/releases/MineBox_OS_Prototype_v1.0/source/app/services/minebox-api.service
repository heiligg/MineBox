[Unit]
Description=MineBox API
Documentation=http://127.0.0.1:8080/docs
# SoftAP-first: do not wait for internet. Prefer local network stack.
After=network-pre.target systemd-networkd.service hostapd.service
Wants=systemd-networkd.service
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
User=minebox
Group=minebox
WorkingDirectory=/opt/minebox
Environment=PYTHONPATH=/opt/minebox
Environment=PYTHONUNBUFFERED=1
ExecStartPre=+/usr/bin/python3 /opt/minebox/scripts/minebox_fix_minecraft_perms.py
ExecStart=/usr/bin/python3 /opt/minebox/scripts/minebox_api_run.py
Restart=on-failure
RestartSec=3
TimeoutStartSec=60
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/minebox /opt/minecraft /var/lib/minebox /var/log/minebox /home/minebox /etc/minebox

[Install]
WantedBy=multi-user.target
