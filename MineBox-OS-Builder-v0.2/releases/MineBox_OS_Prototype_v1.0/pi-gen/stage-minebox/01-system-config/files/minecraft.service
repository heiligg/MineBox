[Unit]
Description=MineBox active Minecraft server
Documentation=file:///opt/minebox/docs/v1/Systemd_Services.md
# SoftAP-first appliances may never reach network-online; keep as Wants only.
After=network-online.target local-fs.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=minebox
Group=minebox
WorkingDirectory=/opt/minecraft
Environment=PYTHONPATH=/opt/minebox
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m services.launcher
TimeoutStartSec=900
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
SuccessExitStatus=0 130 143
StandardOutput=journal
StandardError=journal
SyslogIdentifier=minebox-minecraft

[Install]
WantedBy=multi-user.target
