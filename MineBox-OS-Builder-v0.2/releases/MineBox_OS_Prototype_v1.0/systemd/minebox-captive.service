[Unit]
Description=MineBox hotspot captive portal (port 80)
Documentation=http://192.168.4.1/
After=minebox-api.service hostapd.service dnsmasq.service
Wants=minebox-api.service
StartLimitIntervalSec=120
StartLimitBurst=8

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/minebox/scripts/minebox_captive.py
Restart=on-failure
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
# Port 80 requires privilege; keep the process minimal.
User=root
Group=root

[Install]
WantedBy=multi-user.target
