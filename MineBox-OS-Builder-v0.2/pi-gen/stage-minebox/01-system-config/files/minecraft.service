[Unit]
Description=MineBox active Minecraft server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minebox
Group=minebox
WorkingDirectory=/opt/minecraft
Environment=PYTHONPATH=/opt/minebox
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m services.launcher
TimeoutStartSec=900
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
SuccessExitStatus=0 130 143

[Install]
WantedBy=multi-user.target
